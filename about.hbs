<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Emiu2 — Third-Party Licenses</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 60rem; margin: 2rem auto; padding: 0 1rem; line-height: 1.5; }
    h1 { border-bottom: 2px solid #ccc; padding-bottom: .3rem; }
    .intro { color: #444; }
    .license { margin-top: 2.5rem; }
    .license h2 { background: #f0f0f0; padding: .4rem .6rem; border-radius: 4px; }
    .used-by { font-size: .9rem; color: #555; }
    .used-by ul { columns: 2; }
    pre { background: #fafafa; border: 1px solid #e0e0e0; border-radius: 4px; padding: 1rem; overflow-x: auto; white-space: pre-wrap; }
  </style>
</head>
<body>
  <h1>Third-Party Licenses</h1>
  <p class="intro">
    The Emiu2 emulator incorporates the open-source components listed below.
    This file is generated by <code>cargo about generate</code>; do not edit
    it by hand.
  </p>

  {{#each licenses}}
  <div class="license">
    <h2>{{name}}</h2>
    <p class="used-by">Used by:</p>
    <ul class="used-by">
      {{#each used_by}}
      <li>
        <a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a>
      </li>
      {{/each}}
    </ul>
    <pre>{{text}}</pre>
  </div>
  {{/each}}
</body>
</html>
